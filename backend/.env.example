# Copy to backend/.env and edit.  Never commit the real .env file.

# development | production   (production refuses to start without SECRET_KEY)
ENV=development

# REQUIRED in production. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite by default (file next to the backend folder). PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost/phishlens
# DATABASE_URL=

# Comma-separated list of origins allowed to call the API from a DIFFERENT site.
# Leave empty when the frontend is served by this same server (the default setup).
CORS_ORIGINS=

# The first account that registers becomes admin (turn this off in production and use ADMIN_EMAILS)
FIRST_USER_IS_ADMIN=true
ADMIN_EMAILS=

# bcrypt cost factor (12 is a sensible default; raise as hardware gets faster)
BCRYPT_ROUNDS=12

# Password-reset e-mails. If SMTP_HOST is empty, codes are NOT sent; in development
# the API returns the code in the response so you can test the flow.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PhishLens <no-reply@example.com>
